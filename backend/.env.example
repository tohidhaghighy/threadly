# Threadly backend — SQL Server (SSMS)
PORT=3001
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=604800

# Preferred: full ADO.NET connection string (do not commit real secrets)
DB_CONNECTION_STRING='Password=CHANGE_ME;User ID=admin;Initial Catalog=threadly-fater;Data Source=127.0.0.1,1433;TrustServerCertificate=True'

# Or split settings (used when DB_CONNECTION_STRING is empty):
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_USER=admin
# DB_PASSWORD=CHANGE_ME
# DB_NAME=threadly-fater
# DB_TRUST_SERVER_CERTIFICATE=true
# DB_ENCRYPT=true

# Auto-create/update schema on boot (set false in locked production)
TYPEORM_SYNC=true
TYPEORM_LOGGING=false

# Optional seed of demo hardware Q&A
SEED_DEMO_DATA=false
